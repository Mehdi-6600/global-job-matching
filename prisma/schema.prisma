generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           String    @default("JOB_SEEKER")
  plan           String    @default("free")
  planStartedAt  DateTime?
  planExpiresAt  DateTime?
  billingCycle   String?
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  accounts              Account[]
  sessions              Session[]
  companies             Company[]
  jobs                  Job[]                 @relation("PostedBy")
  transactions          Transaction[]
  paymentIntents        PaymentIntent[]
  applications          Application[]
  notifications         Notification[]
  messages              Message[]             @relation("SentMessages")
  receivedMessages      Message[]             @relation("ReceivedMessages")
  interviews            Interview[]
  savedJobs             SavedJob[]
  jobAlerts             JobAlert[]
  profile               Profile?
  blogPosts             BlogPost[]
  subscribers           Subscriber[]
  usageEvents           UsageEvent[]
  careerRiskAssessments CareerRiskAssessment[]

  @@index([email])
  @@index([role])
  @@index([plan])
  @@index([planExpiresAt])
  @@index([sessionVersion])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  description String?  @db.Text
  location    String?
  website     String?
  logo        String?
  ownerId     String?
  email       String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  owner      User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jobs       Job[]
  interviews Interview[]

  @@index([ownerId])
  @@index([status])
}

model Job {
  id                   String    @id @default(cuid())
  title                String
  description          String    @db.Text
  location             String
  salary               String?
  type                 String
  remote               Boolean   @default(false)
  experience           String?
  salaryMin            Int?
  salaryMax            Int?
  currency             String    @default("USD")
  requirements         String[]  @default([])
  responsibilities     String[]  @default([])
  benefits             String[]  @default([])
  tags                 String[]  @default([])
  status               String    @default("active")
  deadline             DateTime?
  viewCount            Int       @default(0)
  companyId            String?
  postedById           String?
  categoryId           String?
  externalId           String?
  externalUrl          String?
  source               String?
  applyUrl             String?
  publishedAt          DateTime?
  firstSeenAt          DateTime?
  lastSeenAt           DateTime?
  lastVerifiedAt       DateTime?
  expiresAt            DateTime?
  freshnessStatus      String?   @default("fresh")
  occupation           String?
  occupationFamily     String?
  seniority            String?
  descriptionIsSnippet Boolean   @default(false)
  qualityScore         Float?
  attribution          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  postedBy     User?         @relation("PostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  applications Application[]
  savedJobs    SavedJob[]
  interviews   Interview[]

  @@index([status])
  @@index([companyId])
  @@index([postedById])
  @@index([categoryId])
  @@index([createdAt])
  @@index([externalId])
  @@index([source])
  @@index([freshnessStatus])
}

model JobSource {
  id                     String    @id @default(cuid())
  key                    String    @unique
  name                   String
  type                   String    @default("aggregator")
  baseUrl                String?
  apiUrl                 String?
  licenseStatus          String    @default("UNKNOWN")
  commercialAllowed      Boolean   @default(false)
  redistributionAllowed  Boolean   @default(false)
  attributionRequired    Boolean   @default(true)
  canonicalApplyRequired Boolean   @default(true)
  countries              String[]  @default([])
  supportedOccupations   String[]  @default([])
  refreshIntervalMinutes Int       @default(1440)
  rateLimitPerMinute     Int?
  enabled                Boolean   @default(false)
  healthStatus           String    @default("unknown")
  qualityScore           Float     @default(0.5)
  lastSyncAt             DateTime?
  lastSuccessAt          DateTime?
  lastErrorAt            DateTime?
  lastError              String?
  jobsFetched            Int       @default(0)
  jobsCreated            Int       @default(0)
  jobsUpdated            Int       @default(0)
  jobsSkipped            Int       @default(0)
  duplicateRate          Float?
  staleRate              Float?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([enabled])
  @@index([licenseStatus])
}

model Application {
  id          String   @id @default(cuid())
  userId      String
  jobId       String
  status      String   @default("pending")
  coverLetter String?  @db.Text
  resumeUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
}

model PaymentIntent {
  id                   String   @id @default(cuid())
  userId               String
  planId               String
  billingCycle         String   @default("monthly")
  amountUsd            Decimal  @db.Decimal(12, 2)
  cryptoType           String
  rateUsd              Decimal  @db.Decimal(18, 8)
  rateSource           String
  rateFetchedAt        DateTime
  expectedCryptoAmount Decimal  @db.Decimal(24, 12)
  recipientAddress     String
  status               String   @default("pending")
  expiresAt            DateTime
  transactionId        String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([expiresAt])
  @@index([status])
}

model Transaction {
  id                   String   @id @default(cuid())
  userId               String
  planId               String
  amount               Decimal  @db.Decimal(12, 2)
  currency             String   @default("USD")
  cryptoType           String?
  txHash               String?  @unique
  status               String   @default("pending")
  type                 String   @default("crypto")
  billingCycle         String?  @default("monthly")
  paymentIntentId      String?  @unique
  recipientAddress     String?
  expectedCryptoAmount Decimal? @db.Decimal(24, 12)
  rateUsd              Decimal? @db.Decimal(18, 8)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentIntent PaymentIntent?

  @@index([userId])
  @@index([status])
  @@index([txHash])
  @@index([paymentIntentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("info")
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Interview {
  id            String    @id @default(cuid())
  applicationId String?
  jobId         String
  companyId     String?
  userId        String
  scheduledAt   DateTime?
  status        String    @default("pending")
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([companyId])
  @@index([status])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

model JobAlert {
  id        String   @id @default(cuid())
  userId    String
  keywords  String?
  location  String?
  remote    Boolean?
  frequency String   @default("daily")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  bio        String?  @db.Text
  skills     String?
  experience String?  @db.Text
  education  String?  @db.Text
  resumeUrl  String?
  phone      String?
  location   String?
  linkedin   String?
  github     String?
  portfolio  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CareerRiskAssessment {
  id              String   @id @default(cuid())
  userId          String
  jobTitle        String
  skills          String?  @db.Text
  industry        String?
  experienceYears Int?
  country         String?
  location        String?
  education       String?
  riskScore       Int
  riskLevel       String
  summary         String   @db.Text
  reasons         Json
  skillsToBuild   Json
  alternatives    Json
  source          String
  paidSnapshot    Boolean  @default(false)
  shareToken      String   @unique
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([shareToken])
}

model BlogPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String   @db.Text
  excerpt    String?
  coverImage String?
  published  Boolean  @default(false)
  authorId   String
  category   String?
  tags       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([published])
  @@index([slug])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  color     String?
  createdAt DateTime @default(now())

  jobs Job[]

  @@index([slug])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userId    String?
  ipHash    String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([userId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  periodKey String?
  meta      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([userId, kind, periodKey])
}
