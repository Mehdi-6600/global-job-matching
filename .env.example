# ============================================================
# Database (REQUIRED)
# ============================================================
DATABASE_URL="postgresql://user:password@localhost:5432/globaljobmatching?schema=public"

# ============================================================
# Authentication - NextAuth v5 (REQUIRED)
# ============================================================
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
AUTH_URL="http://localhost:3000"

# ============================================================
# OAuth (OPTIONAL)
# ============================================================
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ============================================================
# Email - Resend (REQUIRED for email features)
# ============================================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ============================================================
# Rate Limiting - Upstash Redis / Vercel KV (OPTIONAL but recommended in production)
# ============================================================
KV_URL=""
KV_REST_API_TOKEN=""
KV_REST_API_READ_ONLY_TOKEN=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ============================================================
# Admin / Owner (REQUIRED)
# ============================================================
OWNER_EMAIL="admin@yourdomain.com"

# ============================================================
# Job sync (REQUIRED for /api/jobs/sync)
# Authorization: Bearer <SYNC_SECRET>
# ============================================================
SYNC_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# ============================================================
# AI (OPTIONAL — template fallback if missing)
# ============================================================
OPENAI_API_KEY=""
# OPENROUTER_API_KEY=""

# ============================================================
# Crypto wallets (OPTIONAL — payment feature)
# ============================================================
# CRYPTO_WALLET_BTC=""
# CRYPTO_WALLET_ETH=""
# CRYPTO_WALLET_USDT=""
# CRYPTO_WALLET_BNB=""
# CRYPTO_WALLET_USDC=""
# CRYPTO_WALLET_DOGE=""
# CRYPTO_WALLET_TON=""

# ============================================================
# Blob storage for resumes (OPTIONAL)
# ============================================================
# BLOB_READ_WRITE_TOKEN=""

# ============================================================
# Application
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
