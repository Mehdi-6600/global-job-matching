# ─── Core ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
AUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
AUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_URL="https://your-domain.vercel.app"

NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

OWNER_EMAIL="you@example.com"
SYNC_SECRET="generate-another-long-random-string-32+"
CRON_SECRET="generate-cron-secret-at-least-16-chars"
SEED_SECRET="dev-only-seed-secret"

# ─── Google OAuth (optional) ──────────────────────────────────
# Set BOTH GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET, or NEITHER.
# If set, also set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="1" so the login
# page renders the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="0"

# ─── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Global Job Matching <noreply@yourdomain.com>"
EMAIL_FROM="Global Job Matching <noreply@yourdomain.com>"

# ─── Rate limiting (Upstash Redis — optional) ─────────────────
# Leave EMPTY to use in-memory fallback (per-instance, but functional).
# Only set BOTH url and token together if Redis is provisioned.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── AI ───────────────────────────────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OPENROUTER_FALLBACK_MODEL="openrouter/auto"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ─── Resume storage (Vercel Blob) ─────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─── Crypto wallets (only non-empty addresses are shown) ──────
CRYPTO_BTC_ADDRESS=""
CRYPTO_ETH_ADDRESS=""
CRYPTO_BNB_ADDRESS=""
CRYPTO_USDT_ADDRESS=""
CRYPTO_USDC_ADDRESS=""
CRYPTO_DOGE_ADDRESS=""
CRYPTO_TON_ADDRESS=""

# ─── Crypto auto-verification (optional but recommended) ───────
# If EMPTY, payments stay "pending" for manual admin approval (24h).
# If SET, cron auto-confirms in ~5-10 min via on-chain check.
# Get free keys in 2 min: TronGrid.io + bsc-dataseed.binance.org
TRONGRID_API_KEY=""
TRONGRID_API_URL="https://api.trongrid.io"
CRYPTO_BSC_RPC_URL="https://bsc-dataseed.binance.org/"
CRYPTO_EVM_RPC_URL="https://eth.llamarpc.com"
# Optional overrides:
# CRYPTO_ETH_RPC_URL=""
# CRYPTO_MIN_CONFIRMATIONS="2"
# CRYPTO_MIN_CONF_BTC="1"
# CRYPTO_MIN_CONF_DOGE="10"
