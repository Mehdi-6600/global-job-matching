# ─── Core ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
AUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
AUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_URL="https://your-domain.vercel.app"

NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

OWNER_EMAIL="you@example.com"
SYNC_SECRET="generate-another-long-random-string-32+"
CRON_SECRET="generate-cron-secret-at-least-16-chars"
SEED_SECRET="dev-only-seed-secret"

# ─── Google OAuth (optional) ──────────────────────────────────
# Set BOTH GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET, or NEITHER.
# If set, also set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="1" so the login
# page renders the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="0"

# ─── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Global Job Matching <noreply@yourdomain.com>"
EMAIL_FROM="Global Job Matching <noreply@yourdomain.com>"

# ─── Upstash Redis (preferred for rate limits) ────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Or Vercel KV / marketplace names ─────────────────────────
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_URL=""
KV_REST_API_READ_ONLY_TOKEN=""
UPSTASH_KV_REST_API_URL=""
UPSTASH_KV_REST_API_TOKEN=""
UPSTASH_KV_REDIS_URL=""
UPSTASH_KV_REDIS_TOKEN=""

# ─── AI ───────────────────────────────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OPENROUTER_FALLBACK_MODEL="openrouter/auto"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ─── Resume storage (Vercel Blob) ─────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─── Crypto wallets (only non-empty addresses are shown) ──────
CRYPTO_BTC_ADDRESS=""
