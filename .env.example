# Database
DATABASE_URL="postgresql://user:password@localhost:5432/globaljobmatching?schema=public"

# Auth (NextAuth v5)
AUTH_SECRET="your-auth-secret-min-32-chars-long-here"
AUTH_URL="http://localhost:3000"

# OAuth (optional — email/password is primary)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Resend Email
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Rate Limiting (Upstash Redis / Vercel KV)
KV_URL=""
KV_REST_API_TOKEN=""
KV_REST_API_READ_ONLY_TOKEN=""

# Admin / Owner
OWNER_EMAIL="admin@yourdomain.com"

# AI (OpenRouter or OpenAI for resume generation & job threat analysis)
OPENAI_API_KEY="sk-xxxxxxxx"
# or OPENROUTER_API_KEY=""

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
