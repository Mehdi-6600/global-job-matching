# ─── Core ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# Production:
# AUTH_URL="https://your-domain.com"

# Owner bootstrap (optional)
OWNER_EMAIL="you@example.com"

# ─── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Global Job Matching <onboarding@resend.dev>"
# RESEND_FROM_EMAIL=""

# ─── Rate limit / Redis (optional but recommended in prod) ────
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# ─── AI ───────────────────────────────────────────────────────
# OPENROUTER_API_KEY=""
# OPENAI_API_KEY=""

# ─── Job sync ─────────────────────────────────────────────────
# SYNC_SECRET=""

# ─── Resume file storage (REQUIRED for real PDF upload) ───────
# Create a Blob store in Vercel → Project → Storage → Blob
# then copy the read/write token:
BLOB_READ_WRITE_TOKEN=""

# ─── Crypto wallets (optional) ────────────────────────────────
